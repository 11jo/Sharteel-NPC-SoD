@500  = ~To chyba oznacza, że stałam się wolna od was, idiotów?~
@501  = ~Właściwie to nie, mogę jeszcze potrzebować twoich usług.~
@502  = ~Twoja uprzejmość jest ujmująca, naprawdę, ale po przemyśleniu sprawy sądzę, że możesz się jeszcze przydać.~
@503  = ~Tak.~
@504  = ~Tak, już czas się rozstać.~
@505  = ~Nie, to pomyłka. Zostań, proszę.~
@506  = ~Nie jestem tu, by bawić się w takie gierki, <CHARNAME>.~
@507  = ~Nareszcie.~
@508  = ~Mam już tego dość. Między nami sprawy zakończone.~
@509  = ~Mam dość zadawania się z głupcami.~
