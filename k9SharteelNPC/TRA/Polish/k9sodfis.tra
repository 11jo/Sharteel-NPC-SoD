@1000 = ~Hmm...Shar-Teel. Ta to dopiero jest wredna. Córka Angela, jednego z pomagierów Sarevoka. Lepiej mieć się przy niej na baczności. Podpaliłaby to miasto w okamgnieniu, gdyby ją wypuścić.~
@1001 = ~Hej przyjacielu, może zabrzmi to dziwnie, ale potrzebuję od ciebie pewnej przysługi. Eltan polecił mi przyprowadzić do niego Shar-Teel. Może zechcesz ją zostawić pod moja strażą?~
@1002 = ~Muszę z nią porozmawiać.~
@1003 = ~Ma zostać zwolniona. Natychmiast.~
@1004 = ~Nigdzie stąd nie pójdzie, to pewne. Ale możesz z nią pogadać, jeśli chcesz.~
@1005 = ~Hehe, niezły żart. Z tego co słyszałem, to książę Eltan osobiście się nią interesuje. Nie zostanie wypuszczone, dopóki on tak nie zadecyduje.~
@1006 = ~Jestem bohaterem Wrót Baldura. Chyba o mnie słyszałeś? Eltan polecił mi, bym doprowadził ją przed jego oblicze. Chcesz, by książę przez ciebie czekał?~ ~Jestem bohaterką Wrót Baldura. Chyba o mnie słyszałeś? Eltan polecił mi, bym doprowadziła ją przed jego oblicze. Chcesz, by książę przez ciebie czekał?~
@1007 = ~Jestem bohaterem Wrót Baldura. Chyba o mnie słyszałeś? Jak sądzisz, co robię z tymi, którzy mi odmawiają?~ ~Jestem bohaterką Wrót Baldura. Chyba o mnie słyszałeś? Jak sądzisz, co robię z tymi, którzy mi odmawiają?~
@1008 = ~W takim razie mam tu dla ciebie list.~
@1009 = ~Dobrze, wrócę tu z pozwoleniem od księcia.~
@1010 = ~Hmmm... a niech mnie. Jeszcze dziś rano książę mówił mi co innego. Ale rozkaz to rozkaz. No dobrze, zabieraj ją.~
@1011 = ~Hmmm... tak myślałem, że to ty. No cóż, daleki jestem od tego, żeby powstrzymywać bohatera Wrót Baldura. Nie ma potrzeby się bić. Jeśli tak ją chcesz, to proszę bardzo. Dam znać Eltanowi, że Shar-Teel jest z tobą.~ ~Hmmm... tak myślałem, że to ty. No cóż, daleki jestem od tego, żeby powstrzymywać bohaterkę Wrót Baldura. Nie ma potrzeby się bić. Jeśli tak ją chcesz, to proszę bardzo. Dam znać Eltanowi, że Shar-Teel jest z tobą.~
@1012 = ~Hmmm... właściwie to nie powinniśmy tego robić. Ale wiadomo, Eltan musi mieć do ciebie duże zaufanie, skoro ty i twoi towarzysze to bohaterowie miasta. Chyba więc nic złego się nie zdarzy. Wobec tego zabieraj ją sobie.~
@1013 = ~Chyba już wszystko załatwiliśmy. Czego jeszcze chcecie?~
@1014 = ~Przychodzimy po rzeczy Shar-Teel.~
@1015 = ~Niczego. Już sobie idziemy.~
@1016 = ~Prawda. Tylko cóż, wszystko już zdążyliśmy wyprzedać. Szczerze mówiąc, to nie spodziewaliśmy się, że jeszcze będzie tego potrzebowała. Mam tu kilka porządnych rzeczy, które się jej przydadzą, ale mogą nie spełnić jej oczekiwań.~
